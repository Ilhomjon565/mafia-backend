PORT=4100
BIND_HOST=127.0.0.1   # nginx ortida: portni tashqariga ochmaslik
NODE_ENV=production
FRONTEND_URL=https://mafia-game.uz

DATABASE_URL=postgresql://mafia:CHANGE_ME@localhost:5432/mafia_db

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=3

JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# Google Sign-In (frontend bilan bir xil client ID bo'lishi shart)
GOOGLE_CLIENT_ID=

# Admin panelni yashiradigan maxfiy kalit (kalitsiz /api/admin/* → 404)
ADMIN_ACCESS_KEY=

# Cloudflare TURN — ovozli chat NAT ortida ham ishlashi uchun
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=

# `node seed.js` uchun: berilmasa skript kuchli tasodifiy parol yaratib chop etadi
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=

# Admin panelga kirishni Telegram orqali tasdiqlash
TG_ADMIN_BOT_TOKEN=
TG_ADMIN_CHAT_ID=
# Yangi ochiq xonalar e'lon qilinadigan guruh (supergroup id manfiy: -100...)
TG_GROUP_CHAT_ID=
# Botga /start bosganlar yo'naltiriladigan guruh havolasi
TG_GROUP_LINK=https://t.me/uzbekistan_mafia_games

# --- Socket flood/bot himoyasi (hammasi ixtiyoriy, standart qiymatlar kodda) ---
SOCKET_REQUIRE_AUTH=1      # 0 = tokensiz socketga ham ruxsat (favqulodda holat uchun)
MAX_TOTAL_SOCKETS=3000     # serverdagi umumiy ochiq socket chegarasi
MAX_CONN_PER_IP=30         # bitta IP dan ochiq socketlar
MAX_HANDSHAKE_PER_IP=60    # bitta IP dan 10 s da tokenli ulanish urinishlari
IDLE_SOCKET_MS=120000      # o'yinga kirmagan socket qancha yashaydi
